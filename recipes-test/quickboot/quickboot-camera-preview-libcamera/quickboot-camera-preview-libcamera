# QuickBoot open-source camera preview reference application using libcamera
# and GStreamer. The application is a test vehicle for camera and display
# readiness measurements. It can be run directly or through its opt-in
# systemd unit.

set -eu

APP_NAME="quickboot-camera-preview-libcamera"
CAMERA_WIDTH="${CAMERA_WIDTH:-1920}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-1080}"
CAMERA_FRAMERATE="${CAMERA_FRAMERATE:-30/1}"
LIBCAMERA_SOFTISP_MODE="${LIBCAMERA_SOFTISP_MODE:-cpu}"
CAMERA_CAPS="video/x-raw,width=${CAMERA_WIDTH},height=${CAMERA_HEIGHT},framerate=${CAMERA_FRAMERATE}"

log_message() {
    level="$1"
    message="$2"

    printf '[%s] %s: %s\n' "$level" "$APP_NAME" "$message"
}

log_message "INFO" "QuickBoot libcamera Preview Test Started"
log_message "INFO" "Starting preview with ${CAMERA_CAPS}, SoftISP=${LIBCAMERA_SOFTISP_MODE}"

# Replace the shell process so signals from the test harness or systemd reach
# gst-launch directly. Use the CPU SoftISP because the current GPU SoftISP
# path fails to initialize on the validated Qualcomm Linux image.
exec env "LIBCAMERA_SOFTISP_MODE=${LIBCAMERA_SOFTISP_MODE}" \
    GST_REGISTRY_UPDATE=no \
    gst-launch-1.0 -e \
    libcamerasrc \
    ! "${CAMERA_CAPS}" \
    ! queue \
    ! waylandsink
