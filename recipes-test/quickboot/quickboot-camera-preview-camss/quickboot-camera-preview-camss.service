# Reference systemd entry point for QuickBoot open-source CAMSS camera
# readiness validation. Disabled by default; enable it explicitly from a
# validation or test flow.

[Unit]
Description=QuickBoot CAMSS Camera Preview Readiness Test
Requires=weston.service
After=weston.service

[Service]
User=weston
Group=weston
SupplementaryGroups=video dmaheap
Type=simple
ExecStart=/usr/bin/quickboot-camera-preview-camss
Environment="WAYLAND_DISPLAY=/run/wayland-0"

[Install]
WantedBy=multi-user.target
